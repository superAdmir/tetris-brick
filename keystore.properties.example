# Copy this file to keystore.properties (gitignored, never commit it) and fill in
# your own release-signing details before building a release. Debug builds don't need
# this file at all - they're signed with the default debug key automatically.
#
# storeFile may be an absolute path (recommended - works regardless of the current
# working directory) or a path relative to app/. Keep the actual keystore file itself
# OUTSIDE this repository entirely.

storeFile=/absolute/path/to/your/upload.keystore
storePassword=
keyAlias=upload
keyPassword=
