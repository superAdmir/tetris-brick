<?xml version="1.0" encoding="utf-8"?>
<!--
  Dedicated splash-screen icon: identical geometry to ic_launcher_foreground
  (the core logo mark, reused deliberately), but kept as its own resource
  with NO debug-variant override, ever. This exists specifically so the
  debug launcher-icon marker (see app/src/debug/res/drawable/
  ic_launcher_foreground.xml) can never leak into the Android 12+ system
  splash screen - values-v31/styles.xml's windowSplashScreenAnimatedIcon
  references this file, not ic_launcher_foreground, precisely to keep those
  two concerns (launcher identification vs. splash branding) independent.
-->
