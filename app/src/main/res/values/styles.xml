<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base application theme: dark navy/charcoal with cyan/violet accents.
      Kept as a distinctly-named base (rather than defining AppTheme directly)
      so values-v31/styles.xml can add Android 12+ splash-screen items to
      AppTheme without a self-referencing "parent" cycle - lint (correctly)
      rejects <style name="AppTheme" parent="@style/AppTheme"> even though
      AAPT2 itself resolves it fine per-qualifier at build time.
    -->
    <style name="AppTheme.Base" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorBackground</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:textColorPrimary">@color/colorOnBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="CustomActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="main_activity_button_Style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="main_buttons_style">
        <item name="android:layout_marginStart">@dimen/maxMargin</item>
        <item name="android:layout_marginEnd">@dimen/maxMargin</item>
        <item name="android:background">@drawable/button_shape</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/buttonsStartSize</item>
        <item name="android:layout_marginTop">@dimen/mainMargin</item>
        <item name="android:layout_marginBottom">@dimen/mainMargin</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/ButtonsPadding</item>
    </style>

    <style name="text_view_style">
        <item name="android:textAlignment">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_margin">@dimen/mainMargin</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ImageViewStyle">
        <item name="android:layout_weight">0.15</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
    </style>

    <style name="ColorCircleStyle">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/button_circle</item>
        <item name="android:padding">@dimen/margin8dp</item>
    </style>

    <style name="SpeedItemsStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/button_speed_shape</item>
        <item name="android:fontFamily">sans-serif-condensed-light</item>
        <item name="android:minWidth">@dimen/dimen56dp</item>
        <item name="android:padding">@dimen/minPadding</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:minLines">1</item>
        <item name="android:maxLines">2</item>
        <item name="android:maxWidth">68dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">@dimen/speedPickerTextSize</item>
    </style>

    <style name="ControlButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">@drawable/button_circle</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="DividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1px</item>
        <item name="android:background">@color/colorPrimaryDark</item>
    </style>

    <!-- Filled variant of main_buttons_style for a screen's single primary action
         (Home's "Continue" when a saved game exists, otherwise "New Game"). -->
    <style name="main_buttons_style_primary" parent="main_buttons_style">
        <item name="android:background">@drawable/button_shape_primary</item>
        <item name="android:textColor">@color/colorOnAccent</item>
    </style>

    <style name="DialogActionButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/button_shape</item>
        <item name="android:fontFamily">sans-serif-condensed-light</item>
        <item name="android:padding">@dimen/ButtonsPadding</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/buttonsStartSize</item>
    </style>

    <style name="DialogActionButtonStylePrimary" parent="DialogActionButtonStyle">
        <item name="android:background">@drawable/button_shape_primary</item>
        <item name="android:textColor">@color/colorOnAccent</item>
    </style>

    <!-- Dark-themed AlertDialog (title/message/buttons) matching the app's own surfaces,
         for the small confirm dialogs (e.g. discarding a saved game) that don't need a
         fully custom layout. -->
    <style name="AppAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:windowBackground">@drawable/shape_dialog_background</item>
        <item name="android:textColorPrimary">@color/colorOnBackground</item>
        <item name="android:textColor">@color/colorOnBackground</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppAlertDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppAlertDialogButtonStyle</item>
    </style>

    <style name="AppAlertDialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

</resources>
